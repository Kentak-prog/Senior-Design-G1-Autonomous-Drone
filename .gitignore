__pycache__/
*.py[cod]
.DS_Store
trajectory/sim_output/min_snap_reference.csv
control/__pycache__/
rl/runs/

# Flight and simulation logs (flight_log.csv, vio_events.csv, ...) are several MB each:
# keep them out of git. The pod keeps the originals under /workspace/vio_runs and
# /workspace/px4_runs; figures and summaries in the same folders stay tracked.
Trajectory/isaac_results/**/*.csv

# Real-camera gate runs: raw frames (hundreds of MB) and overlay videos stay local;
# detections.csv, README and handlabel/ are tracked.
vision/live_runs/**/raw_jpg/
vision/live_runs/**/*.mp4

# Camera calibration captures (40 PNGs, ~33 MB) stay local; the solved yml is tracked.
vision/calib/hires_front_frames/

# YOLO gate model: datasets (symlinks into raw_jpg + labels + previews), Ultralytics
# training runs and downloaded base weights stay local. The trained model and its
# training curves are copied to vision/yolo_gate/weights/ and results/ (tracked).
vision/yolo_gate/datasets/
vision/yolo_gate/runs/
vision/yolo_gate/*.pt

# Isaac Sim screen recordings (graphics/videos/*.webm, ~1.3 GB, some > 100 MB) stay local: see graphics/README.md.
graphics/videos/*.webm
# Explainer videos and the gate-CNN stage-4 videos (~63 MB) stay local too.
graphics/videos/explainer_*.mp4
graphics/videos/*_gate-cnn_detections-on-stage4-flight*.mp4
# Poster images stay local, except the control-system block diagram.
graphics/images/poster_*
!graphics/images/poster_big1-control-block-diagram.png
# Diagram SVG sources, the near-empty Isaac camera test frame and the gate-CNN check images stay local too.
graphics/images/diagram_*.svg
graphics/images/isaac_starling2max-c29-model_drone-camera-view.png
graphics/images/*_gate-cnn_contact-sheet.png
graphics/images/*_gate-cnn_no-crop-check.png

# Raw camera frames copied off the drone with flight logs (hundreds of MB; keep detections.csv and logs)
flight_logs/**/raw_jpg/
flight_logs/**/*.mp4
# 2026-11-03 hover PX4 logs (57 MB): kept locally for px4/test_baro_check.py, not committed
flight_logs/2026-11-03/px4_logs/*.ulg
