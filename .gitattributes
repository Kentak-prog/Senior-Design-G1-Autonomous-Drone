# Files that run or are read on Linux (the drone, containers, the Isaac pod) keep LF line
# endings even when checked out on Windows. A CRLF shell script fails with "/bin/sh^M: not found".
*.sh        text eol=lf
*.bash      text eol=lf
*.service   text eol=lf
Dockerfile  text eol=lf
Dockerfile.* text eol=lf
*.dockerfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf

# Binary: never touch.
*.pt     binary
*.onnx   binary
*.tflite binary
*.pdf    binary
*.docx   binary
